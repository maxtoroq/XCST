<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#' xmlns:c='http://maxtoroq.github.io/XCST'>

   <c:use-package name='Grammar'>
      <c:override/>
      <c:accept component='function' names='foo'/>
      <c:with-param name='a' value='1'/>
      <c:accept component='function' names='bar'/>
      <c:override/>
      <c:with-param name='b' value='2'/>
      <c:override/>
   </c:use-package>

</c:module>
