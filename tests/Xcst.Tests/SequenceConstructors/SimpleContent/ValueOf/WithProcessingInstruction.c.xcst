<?xml version="1.0" encoding="utf-8" ?>
<c:module version='1.0' language='C#' xmlns:c='http://maxtoroq.github.io/XCST'>

   <c:template name='c:initial-template'>
      <foo>
         <c:value-of>
            <c:processing-instruction name='baz'>baz</c:processing-instruction>
            <bar>
               <c:processing-instruction name='bar'>bar</c:processing-instruction>
            </bar>
         </c:value-of>
      </foo>
   </c:template>

   <c:template name='expected'>
      <foo>baz </foo>
   </c:template>

</c:module>
