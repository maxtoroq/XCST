<?xml version="1.0" encoding="utf-8" ?>
<?xcst-test language-version="7" ?>
<c:module version='1.0' language='C#' xmlns:c='http://maxtoroq.github.io/XCST'>

   <c:template name='c:initial-template'>
      <output>
         <c:apply-templates value='new[] { 5, 6 }' mode='foo'>
            <c:with-param name='a' value='1'/>
            <c:with-param name='b' value='2' tunnel='yes'/>
         </c:apply-templates>
      </output>
   </c:template>

   <c:template match='int i &amp;&amp; i % 2 != 0' mode='foo'>
      <c:param name='a' as='int' required='yes'/>

      <int>
         <c:value-of value='i * a'/>
      </int>
   </c:template>

   <c:template match='int i &amp;&amp; i % 2 == 0' mode='foo'>
      <c:param name='a' as='int'/>
      <c:param name='b' as='int' tunnel='yes' required='yes'/>

      <int>
         <c:value-of value='i * a * b'/>
      </int>
   </c:template>

   <c:template name='expected'>
      <output>
         <int>5</int>
         <int>12</int>
      </output>
   </c:template>

</c:module>